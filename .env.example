# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database (MariaDB)
# ---------------------------------------------------------------------------
# Only read on first boot; changing them later does NOT update an existing
# db_data volume. To reset: docker compose down -v (destroys all site data).
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Must match how the site is actually reached, incl. port. Wrong value =
# broken assets / redirect loops.
SITE_URL=http://localhost:8080

# Host port published for Apache. Change if 8080 is taken.
HTTP_PORT=8080

# true only where the site is genuinely served over https (behind Cloudflare
# or a TLS proxy). Leaving it true on a plain-HTTP local run locks you out of
# /wp-admin. Must be the literal true/false — it is pasted into PHP.
FORCE_SSL_ADMIN=false

# ---------------------------------------------------------------------------
# WordPress salts — REQUIRED, no defaults
# ---------------------------------------------------------------------------
# The webroot lives in the image, not a volume, so wp-config.php is
# regenerated on every container recreate. Pinning these keeps logins alive
# across deploys. Generate a fresh set (never reuse another environment's):
#   curl -s https://api.wordpress.org/secret-key/1.1/salt/
# and paste the values (the part inside the quotes) below.
WP_AUTH_KEY=
WP_SECURE_AUTH_KEY=
WP_LOGGED_IN_KEY=
WP_NONCE_KEY=
WP_AUTH_SALT=
WP_SECURE_AUTH_SALT=
WP_LOGGED_IN_SALT=
WP_NONCE_SALT=
